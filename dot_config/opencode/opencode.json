{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "coworker",
    "theme": "nord",
    "lsp": true,
    "permission": {
        "bash": {
            "*": "ask",

            "npm *": "allow",
            "npx *": "allow",
            "node *": "allow",
            "bazel *": "allow",
            "bun *": "allow",
            "cargo *": "allow",
            "rustc *": "allow",
            "go *": "allow",
            "rustfmt *": "allow",
            "make *": "allow",
            "gofmt *": "allow",
            "golangci-lint run *": "allow",

            "mkdir *": "allow",
            "pwd *": "allow",
            "date *": "allow",
            "uname *": "allow",
            "hostname *": "allow",
            "whoami *": "allow",
            "id *": "allow",
            "grep *": "allow",
            "pre-commit run*": "allow",
            "echo *": "allow",
            "printf *": "allow",
            "true *": "allow",
            "rg *": "allow",
            "ls *": "allow",
            "cat *": "allow",
            "nl *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "sort *": "allow",
            "uniq *": "allow",
            "comm *": "allow",
            "cut *": "allow",
            "tr *": "allow",
            "awk *": "allow",
            "find *": "allow",
            "wc *": "allow",
            "which *": "allow",
            "type *": "allow",
            "command -v *": "allow",
            "sed *": "allow",
            "diff *": "allow",
            "cmp *": "allow",
            "stat *": "allow",
            "file *": "allow",
            "du *": "allow",
            "df *": "allow",
            "basename *": "allow",
            "dirname *": "allow",
            "realpath *": "allow",
            "readlink *": "allow",
            "jq *": "allow",
            "tar -t*": "allow",

            "git *": "allow",

            "?/.config/scripts/git-default-branch *": "allow",
            "~/.config/scripts/git-default-branch *": "allow",

            "gh pr view *": "allow",
            "gh browse*": "allow",
            "gh pr diff *": "allow",
            "gh pr list *": "allow",
            "gh pr checks *": "allow",
            "gh run view *": "allow",
            "gh run list *": "allow",
            "gh run watch *": "allow",
            "gh search *": "allow",
            "gh api *": "allow",

            "gcloud logging read*": "allow",
            "gcx * query*": "allow",

            "kubectl get *": "allow",
            "kubectl logs *": "allow",
            "kubectl config current-context*": "allow",
            "kubectl config get-contexts*": "allow",

            "GOWORK=off go *": "allow",
            "GOTOOLCHAIN=local go *": "allow",
            "GIT_EDITOR=true git rebase *": "allow",

            "git -*": "ask",
            "git push*": "ask",
            "git reset *--hard*": "ask",
            "git clean*": "ask",
            "git checkout *": "ask",
            "git restore *": "ask",
            "git switch *-f *": "ask",
            "git switch *--force*": "ask",
            "git switch *--discard-changes*": "ask",
            "git stash drop*": "ask",
            "git stash clear*": "ask",
            "git worktree remove*": "ask",
            "git branch *-D*": "ask",
            "git config *": "ask",
            "git config --get *": "allow",

            "gh api *-X*": "ask",
            "gh api *--method*": "ask",
            "gh api *-f *": "ask",
            "gh api *-F *": "ask",
            "gh api *--field*": "ask",
            "gh api *--raw-field*": "ask",
            "gh api *--input*": "ask",

            "find *-exec*": "ask",
            "find *-ok*": "ask",
            "find *-delete*": "ask",
            "sed *-i *": "ask",
            "sed *--in-place*": "ask",

            "*>*~/*": "ask",
            "*>*$HOME*": "ask",
            "*>*/Users/*": "ask",
            "*>*../*": "ask"
        },
        "external_directory": {
            "~/.cargo/**": "allow",
            "~/.config/**": "allow",
            "~/go/pkg/mod/**": "allow",
            "~/Documents/projects/**": "allow",
            "/tmp/**": "allow"
        }
    }
}
